{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "typeshelf",
  "version": "../package.json",
  "identifier": "app.typeshelf",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "typeshelf",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' thumb: http://thumb.localhost asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Fast font manager: preview, organise and activate fonts",
    "publisher": "typeshelf",
    "category": "Utility",
    "copyright": "MIT License",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEMzREOTc2NkE4RTM3MUEKUldRYU40NXFkdGswSGYwNWh6WHdRWE42QW00dmF4UWY5cVRwc05kT1RjenFZTmpuS0VDdzRhUHkK",
      "endpoints": [
        "https://github.com/ipavlovski/typeshelf/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
